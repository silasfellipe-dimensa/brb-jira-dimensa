# Copie este arquivo para .env.local (que já está no .gitignore) e preencha
# com os valores reais. NUNCA commite o .env.local.

# --- Jira ---
JIRA_EMAIL=seu.email@dimensa.com.br
JIRA_TOKEN=cole_aqui_o_token_da_atlassian

# URL publica da aplicacao. Usada para montar o link de confirmacao de
# e-mail, para ele nao depender do "Site URL" do painel do Supabase.
# Local: http://localhost:3000
APP_URL=https://sua-app.vercel.app

# --- Login (Supabase Auth) ---
# Project Settings -> API, no painel do Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave publica. Usada so para cadastro/login. Pode ir para o navegador.
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Chave de servico. IGNORA todas as regras de seguranca do banco.
# Usada so no servidor, para ler/gravar a tabela snapshot.
# NUNCA exponha no navegador, em log, ou em repositorio.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# String aleatoria longa, usada so para assinar o cookie de sessao.
# Gere uma com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque_por_uma_string_aleatoria_longa

# Dominios liberados a entrar, separados por virgula (sem @)
ALLOWED_DOMAINS=totvs.com.br,dimensa.com.br

# E-mails avulsos liberados alem dos dominios acima (ex: cliente BRB), separados por virgula.
# Pode deixar vazio por enquanto.
ALLOWED_EMAILS=

# String aleatoria usada pelo Vercel Cron para provar que quem chamou
# /api/cron-atualizar foi o agendador, nao qualquer um que ache a URL.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=troque_por_outra_string_aleatoria
