{
  "outputDirectory": "static",
  "functions": {
    "api/index.js": {
      "includeFiles": "paginas/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron-atualizar", "schedule": "0 11 * * 1-5" }
  ]
}
